. ***************************************************************************************************************************
. 
. 
. * generating incomplete rate binary identifier
. gen rates_incomplete = (oos_coll_15m==. & year>=2008 & year<=2018)
{txt}
{com}. 
. * generating potential defying rate binary identifier
.         * meaning: contract or phone data implies they don't obey the cap on time 
. gen potential_defier = (oos_coll_15m > coll_cap_15m) & (oos_coll_15m != .) & (year >= 2014) & (year <= 2018)
{txt}
{com}. 
. * generating FIRST DIFFERENCE RATE VARIABLE, and PCT CHANGE
. set varabbrev off
{txt}
{com}. 
. * absolute FD's first
. bysort state: gen fd_oos_coll_15m = oos_coll_15m[_n]-oos_coll_15m[_n-1] if (year >= 2008) & (year <= 2018)
{txt}(493 missing values generated)

{com}. * as percents now
. bysort state: gen fd_pct_coll_15m = (oos_coll_15m[_n]-oos_coll_15m[_n-1])/(oos_coll_15m[_n-1])*100 if (year >= 2008) & (year <= 2018)
{txt}(493 missing values generated)

{com}. 
. set varabbrev on
{txt}
{com}. 
. * identifying early adopters: 11/2012 notice, 11/2013 passed, 2/2014 effected
. * identifying states over cap in early year (early==2013 gives compliers)
. * generating (OVER IN YEAR=EARLY) BINARY IDENTIFIER
. gen early = 1
{txt}
{com}. gen over_early = (year == 2013 - early) & (oos_coll_15m > coll_cap_15m)
{txt}
{com}. bysort state: egen temp_over_early_avg = mean(over_early)
{txt}
{com}. replace over_early=0
{txt}(31 real changes made)

{com}. replace over_early=1 if (temp_over_early_avg > 0)
{txt}(623 real changes made)

{com}. drop (temp_over_early_avg)
{txt}
{com}. 
. * generating (UNDER IN YEAR=EARLY+1) BINARY IDENTIFIER
. gen under_earlyp1 = 0
{txt}
{com}. replace under_earlyp1 = 1 if (year == 2014 - early) & (oos_coll_15m <= coll_cap_15m)
{txt}(20 real changes made)

{com}. bysort state: egen temp_under_earlyp1_avg = mean(under_earlyp1)
{txt}
{com}. replace under_earlyp1 = 0
{txt}(20 real changes made)

{com}. replace under_earlyp1 = 1 if (temp_under_earlyp1_avg > 0)
{txt}(401 real changes made)

{com}. drop (temp_under_earlyp1_avg)
{txt}
{com}. 
. * generating (OVER IN YEAR=EARLY & UNDER IN YEAR=EARLY+1) = EARLY ADOPTER BINARY IDENTIFIER
. gen early_adopt=0
{txt}
{com}. replace early_adopt=1 if (year == 2013 + early) & (over_early == 1) & (under_earlyp1 == 1)
{txt}(2 real changes made)

{com}. drop (over_early under_earlyp1)
{txt}
{com}. tab state if (early_adopt == 1)

