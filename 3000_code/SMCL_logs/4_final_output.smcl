{com}. 
. * constructing event study graphs
. gen event_time = -3 if year==reduc_year-3
{txt}(497 missing values generated)

{com}. replace event_time = -2 if year==reduc_year-2
{txt}(44 real changes made)

{com}. *replace event_time = -1 if year==reduc_year-1 
. replace event_time = 0 if year==reduc_year
{txt}(48 real changes made)

{com}. replace event_time = 1 if year==reduc_year + 1
{txt}(46 real changes made)

{com}. replace event_time = 2 if year==reduc_year + 2
{txt}(43 real changes made)

{com}. replace event_time = 3 if year==reduc_year + 3
{txt}(41 real changes made)

{com}. drop if event_time==.
{txt}(275 observations deleted)

{com}. 
. foreach y in `yit' {c -(}
{txt}  2{com}. gen reduc_etime_`y' = 0
{txt}  3{com}. replace reduc_etime_`y' = etime_T_3_`y' if event_time==-3
{txt}  4{com}. replace reduc_etime_`y' = etime_T_2_`y' if event_time==-2
{txt}  5{com}. replace reduc_etime_`y' = etime_T0_`y' if event_time==0
{txt}  6{com}. replace reduc_etime_`y' = etime_T1_`y' if event_time==1
{txt}  7{com}. replace reduc_etime_`y' = etime_T2_`y' if event_time==2
{txt}  8{com}. replace reduc_etime_`y' = etime_T3_`y' if event_time==3
{txt}  9{com}. 
. gen reduc_etime_`y'_u = reduc_etime_`y'
{txt} 10{com}. replace reduc_etime_`y'_u = reduc_etime_`y'_u + etime_T_3_`y'_se*1.96 if event_time==-3
{txt} 11{com}. replace reduc_etime_`y'_u = reduc_etime_`y'_u + etime_T_2_`y'_se*1.96 if event_time==-2
{txt} 12{com}. replace reduc_etime_`y'_u = reduc_etime_`y'_u + etime_T0_`y'_se*1.96 if event_time==0
{txt} 13{com}. replace reduc_etime_`y'_u = reduc_etime_`y'_u + etime_T1_`y'_se*1.96 if event_time==1
{txt} 14{com}. replace reduc_etime_`y'_u = reduc_etime_`y'_u + etime_T2_`y'_se*1.96 if event_time==2
{txt} 15{com}. replace reduc_etime_`y'_u = reduc_etime_`y'_u + etime_T3_`y'_se*1.96 if event_time==3
{txt} 16{com}. 
. gen reduc_etime_`y'_l = reduc_etime_`y'
{txt} 17{com}. replace reduc_etime_`y'_l = reduc_etime_`y'_l - etime_T_3_`y'_se*1.96 if event_time==-3
{txt} 18{com}. replace reduc_etime_`y'_l = reduc_etime_`y'_l - etime_T_2_`y'_se*1.96 if event_time==-2
{txt} 19{com}. replace reduc_etime_`y'_l = reduc_etime_`y'_l - etime_T0_`y'_se*1.96 if event_time==0
{txt} 20{com}. replace reduc_etime_`y'_l = reduc_etime_`y'_l - etime_T1_`y'_se*1.96 if event_time==1
{txt} 21{com}. replace reduc_etime_`y'_l = reduc_etime_`y'_l - etime_T2_`y'_se*1.96 if event_time==2
{txt} 22{com}. replace reduc_etime_`y'_l = reduc_etime_`y'_l - etime_T3_`y'_se*1.96 if event_time==3
{txt} 23{com}. {c )-}
