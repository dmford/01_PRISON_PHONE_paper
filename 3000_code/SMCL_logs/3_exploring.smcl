{com}. 
. graph combine g2_staff_miscond_all g2_staff_miscond_subs g2_staff_harassment_all g2_staff_harassment_subs, row(2) title("Regression Pretrends SoI, With Pop Controls") subtitle() note("xtreg `o' treat##post i.year `controls' if treat=={c -(}0,1{c )-}, fe vce(cluster state_fips)") iscale(*0.8)
{res}{txt}
{com}. graph export "5000_figures\jpgs\Regression Pretrends SoI, With Pop Controls.jpg", as(jpg) name("Graph") replace
