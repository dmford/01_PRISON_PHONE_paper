. graph combine g5_inmate_noncon_all g5_inmate_noncon_subs g5_inmate_contact_all g5_inmate_contact_subs, row(2) title("T_coll Regression Pretrends IoI, With Pop Controls") subtitle("T_coll_pos = T_coll + 18, forcing positivity") note("xtreg `o' treat##post i.T_coll_pos `controls' if treat=={c -(}0,1{c )-}, fe vce(cluster state_fips), restricted to T_coll<0") iscale(*0.8)
{res}{txt}
