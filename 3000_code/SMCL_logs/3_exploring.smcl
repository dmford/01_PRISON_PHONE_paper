{com}. 
. foreach o of varlist inmate_noncon_all inmate_noncon_subs inmate_contact_all inmate_contact_subs staff_miscond_all staff_miscond_subs staff_harassment_all staff_harassment_subs {c -(}
{txt}  2{com}.         xtset state_fips T_coll_pos
{txt}  3{com}.         keep if T_coll_pos<16
{txt}  4{com}.         xtreg `o' treat_base##caps_enact i.T_coll_pos total_m_pop total_f_pop oneplus_m_pop oneplus_f_pop oneminus_m_pop oneminus_f_pop operational_cap design_cap custody_pop lowest_cap_pct highest_cap_pct if treat_base==0, fe vce(cluster state_fips)
{txt}  5{com}.         predict yhat_`o'_cont
{txt}  6{com}.         xtreg `o' treat_base##caps_enact i.T_coll_pos total_m_pop total_f_pop oneplus_m_pop oneplus_f_pop oneminus_m_pop oneminus_f_pop operational_cap design_cap custody_pop lowest_cap_pct highest_cap_pct if treat_base==1, fe vce(cluster state_fips)
{txt}  7{com}.         predict yhat_`o'_treat
{txt}  8{com}.         tw lfit yhat_`o'_cont T_coll_pos || lfit yhat_`o'_treat T_coll_pos, legend(label(1 Control) label(2 Treatment)) title("T_coll `o' Reg Pretrends") subtitle() note() ytitle() xtitle(T_coll_pos) name(g6_`o')
{txt}  9{com}.         {c )-}
