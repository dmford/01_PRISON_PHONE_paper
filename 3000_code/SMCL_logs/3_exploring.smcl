. graph combine g1_inmate_noncon_all g1_inmate_noncon_subs g1_inmate_contact_all g1_inmate_contact_subs, row(2) title("Regression Pretrends IoI, No Controls") subtitle() note("xtreg `o' treat##post i.year if treat=={c -(}0,1{c )-}, fe vce(cluster state_fips)") iscale(*0.8)
{res}{txt}
{com}. graph export "5000_figures\jpgs\Regression Pretrends IoI, No Controls.jpg", as(jpg) name("Graph") replace
{res}{txt}file {bf:5000_figures\jpgs\Regression Pretrends IoI, No Controls.jpg} written in JPEG format

{com}. 
. graph combine g1_staff_miscond_all g1_staff_miscond_subs g1_staff_harassment_all g1_staff_harassment_subs, row(2) title("Regression Pretrends SoI, No Controls") subtitle() note("xtreg `o' treat##post i.year if treat=={c -(}0,1{c )-}, fe vce(cluster state_fips)") iscale(*0.8)
{res}{txt}
{com}. graph export "5000_figures\jpgs\Regression Pretrends SoI, No Controls.jpg", as(jpg) name("Graph") replace
{res}{txt}file {bf:5000_figures\jpgs\Regression Pretrends SoI, No Controls.jpg} written in JPEG format

{com}. 
. 
. *** RESUMING NOW WITH NAME() OPTION ***
. * with pop controls:
. use "2000_data\500_working\exploring_dta", replace
{txt}
{com}. 
. foreach o of varlist inmate_noncon_all inmate_noncon_subs inmate_contact_all inmate_contact_subs staff_miscond_all staff_miscond_subs staff_harassment_all staff_harassment_subs {c -(}
{txt}  2{com}.         xtset state_fips year
{txt}  3{com}.         keep if year<2014
{txt}  4{com}.         xtreg `o' treat_base##caps_enact i.year total_m_pop total_f_pop oneplus_m_pop oneplus_f_pop oneminus_m_pop oneminus_f_pop if treat_base==0, fe vce(cluster state_fips)
{txt}  5{com}.         predict yhat_`o'_cont
{txt}  6{com}.         xtreg `o' treat_base##caps_enact i.year total_m_pop total_f_pop oneplus_m_pop oneplus_f_pop oneminus_m_pop oneminus_f_pop if treat_base==1, fe vce(cluster state_fips)
{txt}  7{com}.         predict yhat_`o'_treat
{txt}  8{com}.         tw lfit yhat_`o'_cont year || lfit yhat_`o'_treat year , legend(label(1 Control) label(2 Treatment)) title("`o' Regression Pretrends") subtitle() note() ytitle() xtitle() name(g2_`o')
{txt}  9{com}.         {c )-}
{res}
