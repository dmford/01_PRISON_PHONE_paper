{txt}(274 missing values generated)

{com}. 
. * generating T_coll, T_pre, and T_debit timelines
.         * (#years relative to first being observed under cap)
. gen under_oos_coll_cap = (oos_coll_15m <= coll_cap_15m) 
{txt}
{com}. gen under_oos_pre_cap = (oos_pre_15m <= pre_cap_15m) 
{txt}
{com}. gen under_oos_debit_cap = (oos_debit_15m <= debit_cap_15m) 
{txt}
{com}. bysort state_fips: egen temp_coll = min(year) if (under_oos_coll_cap == 1) 
{txt}(619 missing values generated)

{com}. bysort state_fips: egen temp_pre = min(year) if (under_oos_pre_cap == 1) 
{txt}(696 missing values generated)

{com}. bysort state_fips: egen temp_debit = min(year) if (under_oos_debit_cap == 1) 
{txt}(718 missing values generated)

{com}. bysort state_fips: egen minyear_coll = min(temp_coll) 
{txt}
{com}. bysort state_fips: egen minyear_pre = min(temp_pre) 
{txt}(40 missing values generated)

{com}. bysort state_fips: egen minyear_debit = min(temp_debit) 
{txt}(100 missing values generated)

{com}. gen T_coll = (year - minyear_coll) 
{txt}
{com}. gen T_pre = (year - minyear_pre)
{txt}(40 missing values generated)

{com}. gen T_debit = (year - minyear_debit)
{txt}(100 missing values generated)

{com}. drop (under_oos_coll_cap temp_coll minyear_coll) 
{txt}
{com}. drop (under_oos_pre_cap temp_pre minyear_pre) 
{txt}
{com}. drop (under_oos_debit_cap temp_debit minyear_debit)
{txt}
{com}. 
. * structuring T_coll so that it is non-negative
. egen min_T_coll = min(T_coll)
{txt}
{com}. gen T_coll_pos = T_coll + abs(min_T_coll)
{txt}
{com}. sum min_T_coll

