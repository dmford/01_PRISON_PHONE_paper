. ********** GENERATING VARIABLES **********
. 
. * proposed Nov 2012, passed Nov 2013, enacted Feb 2014
. gen caps_proposed = (year>=2013)
{txt}
{com}. gen caps_enact = (year>=2014)
{txt}
{com}. 
. * per-minute phone rate caps: 
. gen coll_cap = 0.25
{txt}
{com}. gen pre_cap = 0.21
{txt}
{com}. gen debit_cap = 0.21
{txt}
{com}. 
. * converting to 15m caps: 
. gen coll_cap_15m = coll_cap*15
{txt}
{com}. gen pre_cap_15m = pre_cap*15
{txt}
{com}. gen debit_cap_15m = debit_cap*15
{txt}
{com}. 
. * POPULATION TOTALS
. * taking 1+, 1-, unsentenced population figures and adding them together, maintaining M/F divide
. gen total_pop = oneplus_tot_pop + oneminus_tot_pop + unsen_tot_pop if (oneplus_tot_pop != .) & (oneminus_tot_pop != .) & (unsen_tot_pop != .)
{txt}(4 missing values generated)

{com}. gen total_m_pop = oneplus_m_pop + oneminus_m_pop + unsen_m_pop if (oneplus_m_pop != .) & (oneminus_m_pop != .) & (unsen_m_pop != .)
{txt}(4 missing values generated)

{com}. gen total_f_pop = oneplus_f_pop + oneminus_f_pop + unsen_f_pop if (oneplus_f_pop != .) & (oneminus_f_pop != .) & (unsen_m_pop != .)
{txt}(4 missing values generated)

{com}. 
. * pop^2 and pop^3
. gen total_pop2 = total_pop*total_pop
{txt}(4 missing values generated)

{com}. gen total_pop3 = total_pop*total_pop*total_pop
{txt}(4 missing values generated)

{com}. 
