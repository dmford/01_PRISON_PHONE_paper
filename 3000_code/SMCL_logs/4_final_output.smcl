{com}. 
. **********
. 
. * #7: same, but drop states that don't have PREA data for T_3 to T3 
. * yit = alpha + si*gamma + ft*delta + largest_reduc*T_3*beta1 + largest_reduc*T_2*beta2 + ... + largest*reduc3*beta6 + eit
. 
. use "2000_data/500_working/final_output_dta", replace
{txt}
{com}. 
. local yit "inmate_noncon_all staff_miscond_all"
{txt}
{com}. 
. bysort state: egen temp_max_reduc = min(fd_oos_coll_15m)
{txt}
{com}. gen max_reduc = abs(temp_max_reduc) 
{txt}
{com}. bysort state: gen temp_reduc_year_id = max_reduc + fd_oos_coll_15m 
{txt}(49 missing values generated)

{com}. bysort state: egen temp_reduc_year = min(year) if temp_reduc_year_id==0 & state!="FLORIDA"
{txt}(491 missing values generated)

{com}. bysort state: egen reduc_year = max(temp_reduc_year) if state!="FLORIDA"
{txt}(11 missing values generated)

{com}. drop temp_max_reduc temp_reduc_year_id temp_reduc_year
{txt}
{com}. 
. la var max_reduc "Largest Observed Out-of-State 15m Collect Call Cost Reduction"
{txt}
{com}. la var reduc_year "Year of Largest Observed Out-of-State 15m Collect Call Cost Reduction"
{txt}
{com}. 
. * NOTE: FLORIDA HAS NO REDUCTIONS, BUT IN FACT, AN INCREASE! RATES UP BY $0.30 IN 2012
. 
. gen eventT_3 = (year==reduc_year-3)
{txt}
{com}. gen eventT_2 = (year==reduc_year-2)
{txt}
{com}. gen eventT0 = (year==reduc_year)
{txt}
{com}. gen eventT1 = (year==reduc_year+1)
{txt}
{com}. gen eventT2 = (year==reduc_year+2)
{txt}
{com}. gen eventT3 = (year==reduc_year+3)
{txt}
{com}. 
. foreach T in eventT_3 eventT_2 eventT0 eventT1 eventT2 eventT3 {c -(}
{txt}  2{com}.         gen max_reduc_`T' = max_reduc*`T'
{txt}  3{com}. {c )-}
{txt}
{com}. 
. local xit "c.total_pop"
{txt}
{com}. local max_reduc_eventT "c.max_reduc_*"
{txt}
{com}. 
. bysort state: egen temp_timeline_check_1 = max(eventT_3) 
{txt}
{com}. bysort state: egen temp_timeline_check_2 = max(eventT3)
{txt}
{com}. bysort state: gen timeline_check = temp_timeline_check_1 + temp_timeline_check_2
{txt}
{com}. gen fulltimeline = (timeline_check==2)
{txt}
{com}. keep if fulltimeline==0 | state=="FLORIDA"
{txt}(385 observations deleted)

{com}. 
. foreach y in `yit' {c -(}
{txt}  2{com}.         reg `y' `max_reduc_eventT' `xit' i.state_fips i.year, vce(cl state_fips)
{txt}  3{com}.         gen etime_T_3_`y' = _b[max_reduc_eventT_3]
{txt}  4{com}.         gen etime_T_3_`y'_se = _se[max_reduc_eventT_3]
{txt}  5{com}.         gen etime_T_2_`y' = _b[max_reduc_eventT_2]
{txt}  6{com}.         gen etime_T_2_`y'_se = _se[max_reduc_eventT_2]
{txt}  7{com}.         gen etime_T0_`y' = _b[max_reduc_eventT0]
{txt}  8{com}.         gen etime_T0_`y'_se = _se[max_reduc_eventT0]
{txt}  9{com}.         gen etime_T1_`y' = _b[max_reduc_eventT1]
{txt} 10{com}.         gen etime_T1_`y'_se = _se[max_reduc_eventT1]
{txt} 11{com}.         gen etime_T2_`y' = _b[max_reduc_eventT2]
{txt} 12{com}.         gen etime_T2_`y'_se = _se[max_reduc_eventT2]
{txt} 13{com}.         gen etime_T3_`y' = _b[max_reduc_eventT3]
{txt} 14{com}.         gen etime_T3_`y'_se = _se[max_reduc_eventT3]
{txt} 15{com}.         *outreg2 using "6000_LaTeX/table_`y'2.1.tex", dec(3) append ctitle(Event Study, Balanced) nocons drop(i.state_fips i.year) label tex(frag) 
. {c )-}

