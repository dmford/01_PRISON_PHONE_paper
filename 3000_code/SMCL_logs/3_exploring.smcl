. graph combine g3_inmate_noncon_all g3_inmate_noncon_subs g3_inmate_contact_all g3_inmate_contact_subs, row(2) title("Regression Pretrends IoI, With Pop & Cap Controls") subtitle() note("xtreg `o' treat##post i.year `controls' if treat=={c -(}0,1{c )-}, fe vce(cluster state_fips)") iscale(*0.8)
{res}{txt}
{com}. graph export "5000_figures\jpgs\Regression Pretrends IoI, With Pop & Cap Controls.jpg", as(jpg) name("Graph") replace
{res}{txt}file {bf:5000_figures\jpgs\Regression Pretrends IoI, With Pop & Cap Controls.jpg} written in JPEG format

{com}. 
. graph combine g3_staff_miscond_all g3_staff_miscond_subs g3_staff_harassment_all g3_staff_harassment_subs, row(2) title("Regression Pretrends SoI, With Pop & Cap Controls") subtitle() note("xtreg `o' treat##post i.year `controls' if treat=={c -(}0,1{c )-}, fe vce(cluster state_fips)") iscale(*0.8)
{res}{txt}
{com}. graph export "5000_figures\jpgs\Regression Pretrends SoI, With Pop & Cap Controls.jpg", as(jpg) name("Graph") replace
{res}{txt}file {bf:5000_figures\jpgs\Regression Pretrends SoI, With Pop & Cap Controls.jpg} written in JPEG format

{com}. 
. 
. ***** now with T_coll (T_coll_pos=16 when T_coll=0)
. * without controls: 
. use "2000_data\500_working\exploring_dta", replace
{txt}
{com}. 
. foreach o of varlist inmate_noncon_all inmate_noncon_subs inmate_contact_all inmate_contact_subs staff_miscond_all staff_miscond_subs staff_harassment_all staff_harassment_subs {c -(}
{txt}  2{com}.         xtset state_fips T_coll_pos
{txt}  3{com}.         keep if T_coll_pos<16
{txt}  4{com}.         xtreg `o' treat_base##caps_enact i.T_coll_pos if treat_base==0, fe vce(cluster state_fips)
{txt}  5{com}.         predict yhat_`o'_cont
{txt}  6{com}.         xtreg `o' treat_base##caps_enact i.T_coll_pos if treat_base==1, fe vce(cluster state_fips)
{txt}  7{com}.         predict yhat_`o'_treat
{txt}  8{com}.         tw lfit yhat_`o'_cont T_coll_pos || lfit yhat_`o'_treat T_coll_pos, legend(label(1 Control) label(2 Treatment)) title("T_coll `o' Reg Pretrends") subtitle() note() ytitle() xtitle(T_coll_pos) name(g4_`o')
{txt}  9{com}.         {c )-}
{res}
