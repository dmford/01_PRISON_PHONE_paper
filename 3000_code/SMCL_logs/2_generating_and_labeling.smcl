. ********** LABELING VARIABLES **********
. 
. 
. * general data
. la var state "State name"
{txt}
{com}. la var year "Year"
{txt}
{com}. la var state_abbrev "Two letter state abbreviations"
{txt}
{com}. la var state_fips "Federal Information Processing System (FIPS) codes"
{txt}
{com}. 
. la var caps_enact "Binary var, 0 until 2014 when FCC caps enacted"
{txt}
{com}. la var caps_proposed "Binary var, 0 until 2013 after rulemaking proposed in 11/2012"
{txt}
{com}. 
. la var oos_coll_bind "Binary var, 1 if 2013 out-of-state collect rate above FCC cap, 0 if else"
{txt}
{com}. la var oos_pre_bind "Binary var, 1 if 2013 out-of-state prepaid rate above FCC cap, 0 if else"
{txt}
{com}. la var oos_debit_bind "Binary var, 1 if 2013 out-of-state debit rate above FCC cap, 0 if else"
{txt}
{com}. la var is_coll_bind "Binary var, 1 if 2013 in-state collect rate above FCC cap, 0 if else"
{txt}
{com}. la var is_pre_bind "Binary var, 1 if 2013 in-state prepaid rate above FCC cap, 0 if else"
{txt}
{com}. la var is_debit_bind "Binary var, 1 if 2013 in-state debit rate above FCC cap, 0 if else"
{txt}
{com}. 
. la var early "How many years are considered for 'early adoption' and 'early treatment' groups"
{txt}
{com}. la var early_adopt "Binary var, 1 if rate lowered early"
{txt}
{com}. 
. la var treat_base "Binary var, 1 if rate was above caps in 2013"
{txt}
{com}. la var treat_early_base "Binary var, 1 if rate was above caps in 2013, adding 'early adopters'"
{txt}
{com}. 
. la var fd_oos_coll_15m "Change in 15m Coll Rate from Previous Year"
{txt}
{com}. la var fd_pct_coll_15m "Percent Change in 15m Coll Rate from Previous Year"
{txt}
{com}. 
. la var T_coll "T=0 when state average collect call rate first observed below FCC caps"
{txt}
{com}. la var T_pre "T=0 when state average prepaid call rate first observed below FCC caps" 
{txt}
{com}. la var T_debit "T=0 when state average debit call rate first observed below FCC caps" 
{txt}
{com}. la var T_alt "T=0 in year where 15m collect rate reduction is largest"
{txt}
{com}. 
. la var drop_bal_T_coll "Binary identifier, 1 if rate dataset is complete for T_coll=0 +/- bal_T_mag years"
{txt}note: label truncated to 80 characters

{com}. la var drop_bal_T_alt "Binary identifier, 1 if rate dataset is complete for T_alt=0 +/- bal_alt_T_mag years"
{txt}note: label truncated to 80 characters

{com}. la var bal_mag_T_coll "3, number of years +/- T_coll=0 yield a decent balanced panel"
{txt}
{com}. la var bal_mag_T_alt "3, number of years +/- T_alt=0 yield a decent balanced panel"
{txt}
{com}. 
. la var min_T_coll "-16, Lowest observed T_coll value, T_coll-min_T_coll = T_coll_pos"
{txt}
{com}. la var min_T_alt "-18, Lowest observed T_alt value, T_alt-min_T_alt = T_alt_pos"
{txt}
{com}. 
. la var T_coll_pos "Literally T_coll + abs(min(T_coll)) to force the variable to be positive, now 0=16"
{txt}note: label truncated to 80 characters

{com}. la var T_alt_pos "Literally T_alt + abs(min(T_alt)) to force the variable to be positive, now 0=18"
{txt}
{com}. 
